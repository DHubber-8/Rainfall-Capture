# Copy to backend/.env  (it is now actually loaded at startup)
DATA_GOV_SG_API_KEY=            # optional but recommended: higher rate limits
WOODLANDS_STATIONS=S210,S227,S104
TEMP_SAMPLE_MINUTES=30          # temperature is sampled this often (readings are 1-minute)
BACKFILL_FROM=2026-09-25        # first date to backfill; run `python -m app.probe` to see how far back the API goes
BACKFILL_ON_STARTUP=1
NO_DATA_RETRY_DAYS=7            # don't re-ask for days the API said it has no data for
MAX_FETCH_DAYS=366
DATA_GOV_REQUEST_INTERVAL=0.25  # seconds between requests (be polite, avoid 429s)
DATA_GOV_CONCURRENCY=3
DB_PATH=./weather.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
